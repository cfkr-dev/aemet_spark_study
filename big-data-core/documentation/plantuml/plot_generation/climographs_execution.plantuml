@startuml
participant "PlotGenerator" as PLOT_GENERATOR
participant "Climograph" as CLIMOGRAPH
participant "JSONStorageBackend" as JSON_STORAGE_BACKEND
participant "AUTO-PLOT API" as AUTO_PLOT_API

PLOT_GENERATOR -> CLIMOGRAPH : generate()
activate CLIMOGRAPH

loop each climateGroup
    CLIMOGRAPH -> CLIMOGRAPH : foreach climateGroup

    loop each climateRecord
        CLIMOGRAPH -> CLIMOGRAPH : foreach climateRecord

        loop each location
            CLIMOGRAPH -> JSON_STORAGE_BACKEND : readJSON(stationInfo)
            JSON_STORAGE_BACKEND --> CLIMOGRAPH : station JSON

            CLIMOGRAPH -> AUTO_PLOT_API : generatePlot(climograph)
            AUTO_PLOT_API --> CLIMOGRAPH : ok
        end
    end
end

CLIMOGRAPH --> PLOT_GENERATOR : done
deactivate CLIMOGRAPH

@enduml
